{
  "@@locale": "en",

  "appTitle": "Alexandria",
  "@appTitle": {
    "description": "The application name, shown in the window title bar."
  },

  "retry": "Try again",
  "@retry": {
    "description": "The action on every failure state that can be retried."
  },

  "coreUnavailableTitle": "Alexandria's core is not available",
  "@coreUnavailableTitle": {
    "description": "Heading of the core-unavailable state (UC-38 AF-04). The catalog is not reachable and no catalog call is attempted from here."
  },

  "loginTitle": "Sign in to Alexandria",
  "@loginTitle": {
    "description": "Heading of the login screen (UC-02). Presented whenever there is no active session."
  },

  "loginEmailLabel": "E-mail",
  "@loginEmailLabel": {
    "description": "Label of the login form's e-mail field."
  },

  "loginPasswordLabel": "Password",
  "@loginPasswordLabel": {
    "description": "Label of the login form's password field."
  },

  "loginSubmit": "Sign in",
  "@loginSubmit": {
    "description": "The login form's primary action."
  },

  "loginEmailMissing": "Enter your e-mail address.",
  "@loginEmailMissing": {
    "description": "UC-02 AF-01: the e-mail field was left empty. The core is not called."
  },

  "loginEmailMalformed": "That does not look like an e-mail address.",
  "@loginEmailMalformed": {
    "description": "UC-02 AF-01: the e-mail field does not hold an address. The core is not called."
  },

  "loginPasswordMissing": "Enter your password.",
  "@loginPasswordMissing": {
    "description": "UC-02 AF-01: the password field was left empty. The core is not called."
  },

  "loginRejected": "That e-mail and password do not match an account.",
  "@loginRejected": {
    "description": "UC-02 AF-02: the core rejected the credentials. Deliberately does not say which of the two was wrong, and does not reveal whether the address is registered."
  },

  "loginNoAccount": "No account has been set up on this computer yet.",
  "@loginNoAccount": {
    "description": "UC-02 AF-03: the core holds no credentials, so the owner is sent to sign-up (UC-01) by the action beside this message."
  },

  "signUpTitle": "Create your Alexandria account",
  "@signUpTitle": {
    "description": "Heading of the sign-up screen (UC-01). Presented on first launch, when the core holds no account."
  },

  "signUpIntro": "This is the only account. Its password cannot be recovered, so choose one you will not lose.",
  "@signUpIntro": {
    "description": "UC-01: explains the stakes before the owner chooses. The core owns no mail transport, so there is no reset to fall back on."
  },

  "signUpPasswordConfirmationLabel": "Repeat password",
  "@signUpPasswordConfirmationLabel": {
    "description": "Label of the sign-up form's second password field."
  },

  "signUpSubmit": "Create account",
  "@signUpSubmit": {
    "description": "The sign-up form's primary action."
  },

  "signUpPasswordConfirmationMissing": "Repeat your password.",
  "@signUpPasswordConfirmationMissing": {
    "description": "UC-01 AF-02: the second password field was left empty. The core is not called."
  },

  "signUpPasswordMismatch": "The two passwords do not match.",
  "@signUpPasswordMismatch": {
    "description": "UC-01 AF-02: the two entries differ. The core is not called."
  },

  "signUpRejected": "Alexandria did not accept those credentials. Try a longer, less predictable password that is not your e-mail address.",
  "@signUpRejected": {
    "description": "UC-01 AF-03: the core rejected the credentials. The core owns the password policy and does not send its reason across the boundary, so this names the rules it enforces without restating them as front-end validation."
  },

  "signUpAccountExists": "An account already exists on this computer. Sign in instead.",
  "@signUpAccountExists": {
    "description": "UC-01 AF-04: the core already holds an account, so registration is refused and the owner is sent to the login screen."
  },

  "signUpGoToLogin": "Go to sign in",
  "@signUpGoToLogin": {
    "description": "UC-01 AF-04: the action that leaves sign-up for the login screen."
  },

  "loginGoToSignUp": "Create an account",
  "@loginGoToSignUp": {
    "description": "UC-02 AF-03: the action that leaves login for the sign-up screen, offered when the core holds no account."
  },

  "loginSessionEndedTitle": "You were signed out",
  "@loginSessionEndedTitle": {
    "description": "UC-02 AF-04: heading shown on the login screen when a session was discarded because the core rejected a call, rather than because the owner signed out."
  },

  "catalogLockedTitle": "Confirm your e-mail address",
  "@catalogLockedTitle": {
    "description": "FR-AU-12 / BR-25: heading of the state that stands in place of the catalog while the account's e-mail is unconfirmed. The prompt itself is UC-40."
  },

  "catalogLockedBody": "Alexandria stays locked until the address {email} is confirmed.",
  "@catalogLockedBody": {
    "description": "FR-AU-12: explains why the catalog is not reachable. The address is named so the owner knows where to look.",
    "placeholders": {
      "email": { "type": "String", "example": "owner@example.com" }
    }
  },

  "failureCoreLibraryNotLoaded": "The Alexandria core could not be loaded from {path}.",
  "@failureCoreLibraryNotLoaded": {
    "description": "Startup step 1 failed. The path attempted is named because it is the only thing that makes this actionable.",
    "placeholders": {
      "path": { "type": "String", "example": "C:\\Program Files\\Alexandria\\alexandria_ffi.dll" }
    }
  },

  "failureApplicationDirectoryUnavailable": "The application folder {path} could not be created.",
  "@failureApplicationDirectoryUnavailable": {
    "description": "Startup step 2 failed: the application-support directory could not be resolved or created.",
    "placeholders": {
      "path": { "type": "String", "example": "C:\\Users\\me\\AppData\\Roaming\\Alexandria" }
    }
  },

  "failureCoreInitializationFailed": "The Alexandria core could not open the catalog.",
  "@failureCoreInitializationFailed": {
    "description": "Startup step 3 failed: alexandria_index_init returned a non-success code."
  },

  "failureCoreUnhealthy": "The Alexandria core reported that it is not healthy.",
  "@failureCoreUnhealthy": {
    "description": "Startup step 4 failed: the core's health status is not the success code."
  },

  "failureCoreVersionUnsupported": "This version of Alexandria needs a core matching {required}, but found {found}.",
  "@failureCoreVersionUnsupported": {
    "description": "Startup step 4 failed: the core's version is outside the supported range. Both versions are stated.",
    "placeholders": {
      "found": { "type": "String", "example": "0.4.0" },
      "required": { "type": "String", "example": ">=0.1.0 <0.2.0" }
    }
  },

  "failurePreferencesUnreadable": "Your preferences could not be read, so the system theme and language are being used.",
  "@failurePreferencesUnreadable": {
    "description": "Startup step 5 fell back. Reported, not fatal."
  },

  "failureInvalidInput": "Alexandria rejected that as invalid.",
  "@failureInvalidInput": {
    "description": "The core rejected the input. Its verdict is final even when local validation passed."
  },

  "failureUnauthorized": "Your session has ended. Please sign in again.",
  "@failureUnauthorized": {
    "description": "The session is absent, expired, or rejected."
  },

  "failureNotInitialized": "Alexandria is not ready yet. Please restart the application.",
  "@failureNotInitialized": {
    "description": "A call was made before the core was initialized — a fault in the startup sequence rather than something the owner did."
  },

  "failureNotFound": "That item no longer exists.",
  "@failureNotFound": {
    "description": "The record does not exist, or has passed the retention window that made it reachable."
  },

  "failureInvalidState": "That cannot be done to this item right now.",
  "@failureInvalidState": {
    "description": "The record exists but is in the wrong state for the operation."
  },

  "failureDisk": "The file could not be read or written on disk. Nothing was changed.",
  "@failureDisk": {
    "description": "A filesystem operation failed. The core leaves the catalog untouched when this happens."
  },

  "failureIntegrity": "The file on disk no longer matches what Alexandria recorded.",
  "@failureIntegrity": {
    "description": "The on-disk file and the catalog record have diverged."
  },

  "failureConfiguration": "Alexandria's configuration could not be read.",
  "@failureConfiguration": {
    "description": "The core's own configuration is missing or unusable."
  },

  "failureConflict": "That already exists in Alexandria.",
  "@failureConflict": {
    "description": "The operation would create something that already exists. Nothing the owner typed was wrong."
  },

  "failureRateLimited": "Too many attempts. Wait a moment and try again.",
  "@failureRateLimited": {
    "description": "The core refused because the caller is asking too often. Nothing the owner typed was wrong; the remedy is to wait."
  },

  "failureServiceUnavailable": "Alexandria could not reach a service it needs, so that step did not happen.",
  "@failureServiceUnavailable": {
    "description": "The core could not reach a dependency — outbound mail being the one that exists today. The catalog is unaffected."
  },

  "rejectionPasswordTooShort": "Use at least {min} characters.",
  "@rejectionPasswordTooShort": {
    "description": "Core rejection password_too_short. The bound comes from the core, which owns the policy.",
    "placeholders": { "min": { "type": "String", "example": "12" } }
  },

  "rejectionPasswordTooLong": "Use at most {max} characters.",
  "@rejectionPasswordTooLong": {
    "description": "Core rejection password_too_long.",
    "placeholders": { "max": { "type": "String", "example": "128" } }
  },

  "rejectionPasswordWhitespace": "A password cannot be only spaces.",
  "@rejectionPasswordWhitespace": {
    "description": "Core rejection password_whitespace."
  },

  "rejectionPasswordRepeatedCharacter": "A password cannot be one character repeated.",
  "@rejectionPasswordRepeatedCharacter": {
    "description": "Core rejection password_repeated_character."
  },

  "rejectionPasswordTooCommon": "That password is too common. Choose something less predictable.",
  "@rejectionPasswordTooCommon": {
    "description": "Core rejection password_too_common."
  },

  "rejectionPasswordContainsEmail": "A password cannot contain your e-mail address.",
  "@rejectionPasswordContainsEmail": {
    "description": "Core rejection password_contains_email, which covers both being the address and containing it."
  },

  "rejectionEmailUntrimmed": "Remove the spaces around your e-mail address.",
  "@rejectionEmailUntrimmed": {
    "description": "Core rejection email_untrimmed."
  },

  "catalogLockedUndeliverable": "The confirmation message could not be sent, so it is not on its way. Alexandria cannot deliver e-mail yet.",
  "@catalogLockedUndeliverable": {
    "description": "UC-01 AF-06: the account was created and the session is open, but the core reported that the confirmation message was not sent. Stated plainly so the owner does not wait for a message that is never coming."
  },

  "failureUnexpected": "Something went wrong in Alexandria.",
  "@failureUnexpected": {
    "description": "A status code this version does not recognize. Keeps the mapping total so an unknown code still reads as a message rather than a raw number."
  }
}
