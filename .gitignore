# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# The Alexandria core's shared library is bundled at package time and built
# locally for development (IR-04); it is never committed.
native/windows/*.dll
native/linux/*.so

# Local log files and scratch databases.
*.log

# gen_l10n's untranslated-messages record; the parity test in test/core/l10n is
# what fails the build, not this file.
/build/

# Golden-comparison artifacts. flutter_test writes the actual, expected, and
# diff images beside the suite when a golden fails; they are evidence for the
# run that produced them and never something to commit.
**/failures/

# The analyzer-rules package's own lock file, written whenever the layering
# rules are run. The lock file that matters is this application's, at the root,
# and it is committed: tools/alexandria_lints is a package consumed by path, and
# Dart's convention is that a package does not commit one. Two lock files
# resolving the same dependencies is one of them going stale.
tools/alexandria_lints/pubspec.lock
